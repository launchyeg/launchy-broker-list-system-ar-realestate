# Admin Dashboard login now uses a real Supabase Auth user instead of
# hardcoded credentials — create the admin's account in
# Supabase Dashboard → Authentication → Users, no env vars needed here.

# reCAPTCHA (replace with real keys)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY==*****
RECAPTCHA_SECRET_KEY==*****

# Supabase
NEXT_PUBLIC_SUPABASE_URL=***
NEXT_PUBLIC_SUPABASE_ANON_KEY=***
SUPABASE_SERVICE_ROLE_KEY=***
